#!/bin/sh
# Stand-in for ssh in tests: prints its arguments, one per line, then acts on the remote command
# (the last argument).
if [ "$1" = "-G" ]; then
	# The effective configuration of the alias "shared", as ssh -G prints it (extract).
	printf '%s\n' 'user u12ab' 'hostname ssh.example.test' 'port 2222' 'hostkeyalias shared-key' \
		'identityfile ~/.ssh/id_ed25519'
	exit 0
fi
for arg in "$@"; do last="$arg"; printf '%s\n' "$arg"; done
case "$last" in
	exit-3) echo "remote failed" >&2; exit 3 ;;
	exit-255) echo "ssh: connect to host: Connection refused" >&2; exit 255 ;;
	sleep) exec sleep 5 ;;
	input) echo "input:"; cat ;;
	# Streams (ADR-0041): a large output, one that trickles longer than the timeout, one cut by
	# an error after part of it.
	big) head -c 20000000 /dev/zero; exit 0 ;;
	trickle) i=0; while [ $i -lt 8 ]; do echo "chunk $i"; sleep 0.1; i=$((i+1)); done; exit 0 ;;
	partial) echo "part of it"; echo "tar: file changed as we read it" >&2; exit 2 ;;
	endless) while :; do echo "more"; sleep 0.05; done ;;
esac
exit 0
